{"title": "Evaluating reverse Polish notation", "view": "array", "steps": [{"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {}, "highlight": [], "stack": [], "vars": {}, "caption": "Reverse Polish notation: numbers wait on a stack; an operator takes the two most recent."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 0}, "highlight": [0], "stack": ["4"], "vars": {}, "caption": "Push 4."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 1}, "highlight": [1], "stack": ["4", "13"], "vars": {}, "caption": "Push 13."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 2}, "highlight": [2], "stack": ["4", "13", "5"], "vars": {}, "caption": "Push 5."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 3}, "highlight": [3], "stack": ["4", "2"], "vars": {}, "caption": "'/': pop 5, then 13. Push 13 / 5 = 2. Division truncates toward zero."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 4}, "highlight": [4], "stack": ["6"], "vars": {}, "caption": "'+': pop 2, then 4. Push 4 + 2 = 6."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 5}, "highlight": [5], "stack": ["6", "2"], "vars": {}, "caption": "Push 2."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {"i": 6}, "highlight": [6], "stack": ["12"], "vars": {}, "caption": "'*': pop 2, then 6. Push 6 * 2 = 12."}, {"array": ["4", "13", "5", "/", "+", "2", "*"], "pointers": {}, "highlight": [], "stack": ["12"], "vars": {"result": 12}, "caption": "One value left: 12. Each token is pushed or popped a constant number of times: O(n)."}]}
