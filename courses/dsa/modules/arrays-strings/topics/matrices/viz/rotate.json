{"title": "Rotating a matrix in place", "view": "grid", "steps": [{"grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "highlight": [], "pointers": {}, "vars": {}, "caption": "Rotate 90\u00b0 clockwise in place = transpose, then reverse every row."}, {"grid": [[1, 4, 3], [2, 5, 6], [7, 8, 9]], "highlight": [[0, 1], [1, 0]], "pointers": {}, "vars": {"r": 0, "c": 1}, "caption": "Transpose: swap (0,1) with (1,0). Only cells above the diagonal, or each pair would swap back."}, {"grid": [[1, 4, 7], [2, 5, 6], [3, 8, 9]], "highlight": [[0, 2], [2, 0]], "pointers": {}, "vars": {"r": 0, "c": 2}, "caption": "Transpose: swap (0,2) with (2,0). Only cells above the diagonal, or each pair would swap back."}, {"grid": [[1, 4, 7], [2, 5, 8], [3, 6, 9]], "highlight": [[1, 2], [2, 1]], "pointers": {}, "vars": {"r": 1, "c": 2}, "caption": "Transpose: swap (1,2) with (2,1). Only cells above the diagonal, or each pair would swap back."}, {"grid": [[1, 4, 7], [2, 5, 8], [3, 6, 9]], "highlight": [[0, 0], [1, 1], [2, 2]], "pointers": {}, "vars": {}, "caption": "Transposed: rows became columns. The diagonal never moves."}, {"grid": [[7, 4, 1], [2, 5, 8], [3, 6, 9]], "highlight": [[0, 0], [0, 1], [0, 2]], "pointers": {}, "vars": {"row": 0}, "caption": "Reverse row 0."}, {"grid": [[7, 4, 1], [8, 5, 2], [3, 6, 9]], "highlight": [[1, 0], [1, 1], [1, 2]], "pointers": {}, "vars": {"row": 1}, "caption": "Reverse row 1."}, {"grid": [[7, 4, 1], [8, 5, 2], [9, 6, 3]], "highlight": [[2, 0], [2, 1], [2, 2]], "pointers": {}, "vars": {"row": 2}, "caption": "Reverse row 2."}, {"grid": [[7, 4, 1], [8, 5, 2], [9, 6, 3]], "highlight": [], "pointers": {}, "vars": {}, "caption": "Rotated clockwise with O(1) extra space. The old first row (1 2 3) is now the last column."}]}
