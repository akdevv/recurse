{"title": "Partition around a pivot", "view": "array", "steps": [{"array": [7, 2, 1, 8, 6, 3, 5, 4], "pointers": {"pivot": 7}, "highlight": [], "vars": {"pivot": 4}, "caption": "Quick sort's partition (Lomuto): pivot = last element (4). Everything left of i will be < pivot."}, {"array": [7, 2, 1, 8, 6, 3, 5, 4], "pointers": {"i": 0, "j": 0, "pivot": 7}, "highlight": [], "dim": [0], "vars": {"a[j]": 7}, "caption": "7 \u2265 4: leave it on the big side."}, {"array": [2, 7, 1, 8, 6, 3, 5, 4], "pointers": {"i": 1, "j": 1, "pivot": 7}, "highlight": [0], "vars": {"a[j]": 2}, "caption": "2 < 4: swap it into the small side at index 0, i = 1."}, {"array": [2, 1, 7, 8, 6, 3, 5, 4], "pointers": {"i": 2, "j": 2, "pivot": 7}, "highlight": [0, 1], "vars": {"a[j]": 1}, "caption": "1 < 4: swap it into the small side at index 1, i = 2."}, {"array": [2, 1, 7, 8, 6, 3, 5, 4], "pointers": {"i": 2, "j": 3, "pivot": 7}, "highlight": [0, 1], "dim": [3], "vars": {"a[j]": 8}, "caption": "8 \u2265 4: leave it on the big side."}, {"array": [2, 1, 7, 8, 6, 3, 5, 4], "pointers": {"i": 2, "j": 4, "pivot": 7}, "highlight": [0, 1], "dim": [4], "vars": {"a[j]": 6}, "caption": "6 \u2265 4: leave it on the big side."}, {"array": [2, 1, 3, 8, 6, 7, 5, 4], "pointers": {"i": 3, "j": 5, "pivot": 7}, "highlight": [0, 1, 2], "vars": {"a[j]": 3}, "caption": "3 < 4: swap it into the small side at index 2, i = 3."}, {"array": [2, 1, 3, 8, 6, 7, 5, 4], "pointers": {"i": 3, "j": 6, "pivot": 7}, "highlight": [0, 1, 2], "dim": [6], "vars": {"a[j]": 5}, "caption": "5 \u2265 4: leave it on the big side."}, {"array": [2, 1, 3, 4, 6, 7, 5, 8], "pointers": {"pivot": 3}, "highlight": [3], "vars": {"pivot index": 3}, "caption": "Swap the pivot to index 3. It's now in its final sorted position; recurse on the two sides. Good pivots \u2192 O(n log n); always the smallest/largest \u2192 O(n\u00b2)."}]}
